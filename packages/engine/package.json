{
  "name": "@lending/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "engine": "./src/main.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -b",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:validate": "prisma validate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@lending/shared": "workspace:*",
    "@lending/bootstrap": "workspace:*",
    "@lending/lifecycle": "workspace:*",
    "@lending/ingester": "workspace:*",
    "@lending/session": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@prisma/client": "^6.1.0",
    "fastify": "^5.1.0",
    "xrpl": "5.1.0-batch.1"
  },
  "devDependencies": {
    "prisma": "^6.1.0"
  }
}

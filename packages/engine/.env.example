# Operational store for the engine — sessions, seat occupancy, and the action log. Separate from the
# ingester's history store. Matches the docker-compose in this package (Postgres on 5433).
ENGINE_DATABASE_URL="postgresql://engine:engine@localhost:5434/engine?schema=public"

# Optional internal treasury for XRP vaults. When set, XRP pools are funded from this pre-funded wallet
# instead of the public faucet — much faster to stand up, no per-request faucet ceiling. It is not
# auto-refilled: keep it topped up, or provisioning fails asking for a top-up. Unset falls back to the
# faucet, so this is opt-in. IOU vaults are unaffected (their liquidity is minted, not funded).
# XRP_TREASURY_SEED="sEd..."
